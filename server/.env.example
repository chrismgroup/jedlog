# Copy to .env for local development. On Render these are set by render.yaml / the dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jetlog
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API (leave empty for mobile-only).
CORS_ORIGINS=
# Optional: enables Expo push security (https://docs.expo.dev/push-notifications/sending-notifications/)
EXPO_ACCESS_TOKEN=
# First admin account, created on first migration only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_PHONE=
